<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0, not net6.0. The tests targeted an EOL framework and rolled forward to whatever
         runtime the machine had (on CI that was 8.0.23), so this library's own suite had never
         exercised the runtime its consumers run on. That matters here more than usual: the POSIX
         shim exists BECAUSE .NET 7 turned on W^X by default, so runtime version is a known-live
         variable in this codebase. -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Microsoft Testing Platform.
         MTP needs the test project to BE an executable; global.json at the repo root is what opts
         `dotnet test` into the MTP command, and from the .NET 10 SDK on it is required rather than
         optional; without it MTP refuses the VSTest target outright.
         Consequence for anyone editing CI: filter and timeout are MTP RUNNER options and belong
         after a bare double-dash separator. The VSTest-style spelling was observed to still be
         accepted by this SDK, so getting it wrong runs green rather than failing loudly; the
         runner form is the documented one, and timeout only exists there. -->
    <!-- RID-specific, so RID-specific natives land in the APP ROOT rather than under
         runtimes/win-<rid>/native. That matters for exactly one thing here, and it is subtle:
         conpty.dll launches OpenConsole.exe from a <arch>/ subdirectory of ITS OWN directory, and the
         ConPTY package stages the hosts at <output>/x64 and <output>/arm64. With the SDK's default
         layout the DLL sits under runtimes/ where no such subdirectory exists, so it finds no host
         and falls back to conhost, silently, which is how 32 samples of inbox vs inbox were
         mistaken for a ConPTY A/B result. It is also what makes
         DefaultDllImportSearchPaths(AssemblyDirectory) meaningful rather than inert.
         A CONSUMER of the package does not need this. The package stages each host next to its
             own conpty.dll — including under runtimes/win-<arch>/native/ for a portable build — and the
             library's import resolver looks there, so a project with no RuntimeIdentifier gets the
             out-of-band path too. Verified by process census on Windows ARM64. This project pins a RID
             only because it is a ProjectReference and so gets none of that packaging. -->
    <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>

    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Stage the OpenConsole.exe hosts that conpty.dll launches, for the out-of-band ConPTY path.

         A CONSUMER of the Porta.Pty package needs none of this. The library carries the ConPTY
         reference and ships buildTransitive/Porta.Pty.targets, which stages the hosts on the consumer's
         side; samples/Porta.Pty.Demo sets no Conpty* property and no ConPTY PackageReference, and gets
         conpty.dll plus both hosts. The only requirement on a consumer is a RID-specific build, since
         that is what flattens native assets into the app root where the imports look.

         This project needs it because it references the library by PROJECT. Package build assets —
         build/ and buildTransitive/ alike — are a NuGet mechanism and do not apply across a
         ProjectReference, and MSBuild properties do not flow across one either. So the test project has
         to arrange its own out-of-band staging, with its own direct ConPTY reference below.

         That is the same gap that let the consumer bug hide: a ProjectReference cannot exercise any of
         the packaging, which is why samples/Porta.Pty.Demo exists and is built from a real .nupkg.

         The flags are needed because the package derives ConptyNativePlatform from PlatformTarget,
         which for a managed project is AnyCPU and matches none of its branches; setting them directly
         works because they are read by its .targets, which imports after this file. -->
    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
    <ConptyRequiresARM64Host>true</ConptyRequiresARM64Host>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001" />
  </ItemGroup>

  <ItemGroup>
    <!-- MSTest 4 + AwesomeAssertions. xunit 2 was the inherited
         choice and cannot run on MTP at all, so it could not have stayed alongside global.json. -->
    <PackageReference Include="MSTest" Version="4.2.3" />
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Porta.Pty\Porta.Pty.csproj" />
  </ItemGroup>

</Project>
