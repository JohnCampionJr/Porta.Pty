<Project>

  <!--
    Stage OpenConsole.exe for CONSUMERS of this package.

    Microsoft.Windows.Console.ConPTY splits its payload in two, and only one half travels transitively:

      runtimes/win-<arch>/native/conpty.dll   flows to any consumer, direct or transitive
      build/native/runtimes/<arch>/OpenConsole.exe  staged by the package's own build/ targets

    Files under build/ import for a DIRECT PackageReference only. Porta.Pty references ConPTY, so our
    build stages the host and our tests pass; a consumer of Porta.Pty gets conpty.dll and nothing else.
    conpty.dll with no host to launch does not fail — it falls back to in-box conhost SILENTLY, which is
    the exact behaviour the out-of-band package was taken to avoid. Verified by packing this library and
    building a win-x64 consumer against it: the output had conpty.dll alone.

    Setting ConptyRequires*Host from here cannot fix it: the targets that read those flags are the ones
    that never import. So we add the items ourselves.

    The package directory is DERIVED from the resolved conpty.dll rather than composed from
    NuGetPackageRoot and a version literal. The consumer's graph decides which ConPTY version wins — a
    direct reference or a unification can move it — and a hard-coded version would resolve to a path that
    silently does not exist. Walking up from the file that actually got resolved cannot disagree with it.
  -->
  <PropertyGroup>
    <PortaPtyConPtyStagingImported>true</PortaPtyConPtyStagingImported>
  </PropertyGroup>

  <!--
    Only for a RID-specific build, because that is the only kind where the host can be reached.

    Native assets from runtimes/<rid>/native/ are flattened into the app root ONLY when the build has a
    RuntimeIdentifier. Without one, conpty.dll stays under runtimes/win-x64/native/ — where the imports,
    pinned to DllImportSearchPath.AssemblyDirectory, will not find it — and the library correctly falls
    back to in-box. Staging the hosts there would put 2.2MB of OpenConsole.exe into an output that cannot
    use them, and would invite the reasonable question of why they are present when out-of-band is not
    actually in play.

    Measured: a consumer with no RuntimeIdentifier gets runtimes/win-{x86,x64,arm64}/native/conpty.dll
    and nothing in the app root.
  -->
  <Target Name="PortaPtyStageConPtyHost"
          AfterTargets="ResolveReferences"
          Condition="'$(PortaPtyStageConPtyHost)' != 'false'">

    <ItemGroup>
      <!-- <pkg>/runtimes/win-<rid>/native/conpty.dll -> up three to <pkg>/. Pure item transforms: a
           %() reference inside a PropertyGroup would batch the whole target instead, and a Condition
           mixing %(Identity) with qualified metadata silently produces nothing. -->
      <_PortaPtyConPtyDll Include="@(ReferenceCopyLocalPaths)"
                          Condition="'%(Filename)%(Extension)' == 'conpty.dll'" />

      <!-- Each host goes NEXT TO ITS OWN conpty.dll, whatever layout the build produced. The DLL's
           DestinationSubDirectory says which that is, and transforms carry metadata across, so the
           destination is derived rather than assumed:

             RID build       dsd = ''                          -> x64\ and arm64\ at the output root
             portable build  dsd = 'runtimes/win-x64/native/'  -> runtimes/win-x64/native/x64\

           The portable case is what lets a consumer skip the RuntimeIdentifier. Native assets are only
           flattened into the app root for a RID-specific build; a portable one keeps the runtimes/ tree,
           and the import resolver looks there too, so the host has to travel with the DLL it belongs to.

           A RID build gets BOTH hosts because an x64 process runs on ARM64 Windows under emulation and
           conpty.dll launches the host matching the PROCESS. A portable build has one conpty.dll per
           arch already, so each gets only its own.

           DestinationSubDirectory, NOT TargetPath. _CopyFilesMarkedCopyLocal composes its destination as
           $(OutDir)%(DestinationSubDirectory)%(Filename)%(Extension) and never reads TargetPath, so with
           TargetPath both hosts copy FLAT and the second silently overwrites the first — measured: a
           win-x64 consumer ended up with one OpenConsole.exe at the root, the ARM64 one. -->
      <_PortaPtyHostX64 Include="@(_PortaPtyConPtyDll->'%(RootDir)%(Directory)../../../build/native/runtimes/x64/OpenConsole.exe')"
                        Condition="'%(_PortaPtyConPtyDll.DestinationSubDirectory)' == '' Or $([System.String]::Copy('%(_PortaPtyConPtyDll.DestinationSubDirectory)').Contains('win-x64'))" />
      <_PortaPtyHostArm64 Include="@(_PortaPtyConPtyDll->'%(RootDir)%(Directory)../../../build/native/runtimes/arm64/OpenConsole.exe')"
                          Condition="'%(_PortaPtyConPtyDll.DestinationSubDirectory)' == '' Or $([System.String]::Copy('%(_PortaPtyConPtyDll.DestinationSubDirectory)').Contains('win-arm64'))" />

      <ReferenceCopyLocalPaths Include="@(_PortaPtyHostX64)">
        <DestinationSubDirectory>%(_PortaPtyHostX64.DestinationSubDirectory)x64\</DestinationSubDirectory>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ReferenceCopyLocalPaths>
      <ReferenceCopyLocalPaths Include="@(_PortaPtyHostArm64)">
        <DestinationSubDirectory>%(_PortaPtyHostArm64.DestinationSubDirectory)arm64\</DestinationSubDirectory>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ReferenceCopyLocalPaths>
    </ItemGroup>

  </Target>

</Project>
